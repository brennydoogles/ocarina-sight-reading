{
  "name": "ocarina-sight-reading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sight-reading trainer for the 12-hole Alto C ocarina",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev:lan": "OCARINA_LAN=1 vite",
    "render:fingerings": "node scripts/render-fingerings.mjs",
    "check:fingerings": "node scripts/render-fingerings.mjs --check",
    "tag:holes": "node scripts/tag-hole-ids.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "pitchy": "^4.1.0",
    "vexflow": "^5.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.0",
    "jsdom": "^28.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
